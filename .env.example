# =============================================================================
# BLDNGSolutions — secrets template (safe to commit)
# Copy to .env and fill real values. On Vercel, set the same names as env vars.
# =============================================================================

FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string

# MySQL / MariaDB (must be reachable from the internet for Vercel)
MYSQL_HOST=your-db-host.example.com
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DB=bdcompleta
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=10
# Set true if the host requires TLS (PlanetScale, many managed MySQL providers)
MYSQL_SSL=false
MYSQL_SSL_VERIFY=false
# MYSQL_SSL_CA=/path/to/ca.pem

# Gmail SMTP (password recovery)
MAIL_SERVER=smtp.googlemail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-app-password

# Google Maps (shipping routes)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google Maps (public contact page)
GOOGLE_MAPS_API_KEY_CONTACT=your-google-maps-contact-api-key

# Stripe (client payments)
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
STRIPE_BUY_BUTTON_ID=buy_btn_xxx
