{% extends './base.html' %}

{% block title %}Nosotros{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/startpage/startdesign.css') }}">
{% endblock %}

{% block body %}
<nav>
  <div class="navbar">
    <div class="logo">
      <a href="{{ url_for('startpage') }}">
        <img src="{{ url_for('static', filename='images/logo.png') }}" alt="BLDNGSolutions" class="logo-image">
        BLDNGSolutions
      </a>
    </div>
    <div class="nav-links">
      <ul class="links">
        <li><a href="{{ url_for('startpage') }}">Inicio</a></li>
        <li><a href="{{ url_for('aboutUs') }}">Nosotros</a></li>
        <li><a href="{{ url_for('contact') }}">Contacto</a></li>
        <li><a href="{{ url_for('productsList') }}">Productos</a></li>
      </ul>
    </div>
  </div>
</nav>

<main class="public-page">
  <section class="public-panel">
    <div class="public-grid">
      <div>
        <h1>¿Qué es BLDNGSolutions?</h1>
        <p class="lead justificado">
          Plataforma de administración para PyMEs dedicadas a la venta y renta de maquinaria de construcción.
          Centraliza operaciones, pedidos y seguimiento en un solo lugar.
        </p>
        <p class="justificado">
          Este proyecto de titulación fue realizado por Josué Alvarado Arrezola para resolver la falta de
          herramientas especializadas en este sector.
        </p>
      </div>
      <div>
        <img src="{{ url_for('static', filename='images/logo.png') }}" alt="Logo" class="brand-mark">
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <p>&copy; 2026 BLDNGSolutions. Todos los derechos reservados.</p>
</footer>
{% endblock %}
