{% extends './base.html' %}

{% block title %}Productos{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/clientuser/products.css') }}">
{% endblock %}

{% block body %}
<header>
  <div class="nav container">
    <div>
      <a href="{{ url_for('startpage') }}" class="btn btn-secondary">Atrás</a>
      <a href="{{ url_for('startpage') }}">
        <img src="{{ url_for('static', filename='images/logo.png') }}" class="small-logo" alt="Logo">
      </a>
    </div>
    <a href="{{ url_for('startpage') }}" class="logo2">BLDNGSolutions</a>
    <span aria-hidden="true" style="width:1.5rem"></span>
  </div>
</header>

<section class="shop container">
  <h1 class="section-title">Catálogo de maquinaria</h1>
  <div class="shop-content">
    {% for product in products %}
    <article class="product-box" data-machine-id="{{ product.id }}">
      <img src="{{ url_for('static', filename='images/products/' + product.image) }}" alt="{{ product.name }}" class="product-img">
      <h2 class="product-title">{{ product.name }}</h2>
      <p class="price-label">Rentas desde</p>
      <span class="price">${{ product.price }} MXN</span>
    </article>
    {% else %}
    <p class="empty-catalog">No hay productos disponibles por ahora.</p>
    {% endfor %}
  </div>
</section>
{% endblock %}
