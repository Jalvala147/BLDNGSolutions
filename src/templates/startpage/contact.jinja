{% extends './base.html' %}

{% block title %}Contacto{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/startpage/startdesign.css') }}">
{% endblock %}

{% block body %}
<nav>
  <div class="navbar">
    <div class="logo">
      <a href="{{ url_for('startpage') }}">
        <img src="{{ url_for('static', filename='images/logo.png') }}" alt="BLDNGSolutions" class="logo-image">
        BLDNGSolutions
      </a>
    </div>
    <div class="nav-links">
      <ul class="links">
        <li><a href="{{ url_for('startpage') }}">Inicio</a></li>
        <li><a href="{{ url_for('aboutUs') }}">Nosotros</a></li>
        <li><a href="{{ url_for('contact') }}">Contacto</a></li>
        <li><a href="{{ url_for('productsList') }}">Productos</a></li>
      </ul>
    </div>
  </div>
</nav>

<main class="public-page">
  <section class="public-panel">
    <h1>Contacto</h1>
    <p class="lead">Contáctanos para obtener más información sobre nuestros servicios.</p>

    <div id="map-container"></div>

    <div class="contact-meta">
      <p><strong>Dirección:</strong> Montes Urales 2236, Guadalajara, Jalisco, C.P. 44320</p>
      <p><strong>Teléfono:</strong> (33) 1339-0936</p>
      <p><strong>Email:</strong> bldngsolutions.mail@gmail.com</p>
    </div>
  </section>
</main>

<footer class="site-footer">
  <p>&copy; 2026 BLDNGSolutions. Todos los derechos reservados.</p>
</footer>

<script>
  function initMap() {
    var coordinates = { lat: 20.7049452, lng: -103.3194802 };
    var map = new google.maps.Map(document.getElementById("map-container"), {
      zoom: 17,
      center: coordinates
    });
    new google.maps.Marker({
      position: coordinates,
      map: map,
      title: "Montes Urales 2236, Guadalajara, Jalisco"
    });
  }
</script>
<script src="https://maps.googleapis.com/maps/api/js?key={{ google_maps_api_key }}&callback=initMap" async defer></script>
{% endblock %}
