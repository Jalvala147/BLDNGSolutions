{% extends './base.html' %}

{% block title %}Contactenos{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename = 'css/startdesign.css') }}" />
<style>
  /* Estilo para el contenedor del mapa */
  #map-container {
    height: 400px;
  }
</style>
{% endblock %}


{% block body %}

<nav>
    <div class="navbar">
        <div class="logo">
            <a href="/startpage">
                <img src="static/images/logo.png" alt="Logo BLDNGSolutions" class="logo-image">
                BLDNGSolutions
            </a>
        </div>
        <div class="nav-links">
            <div class="sidebar-logo">
                <span class="logo-name">BLDNGSolutions</span>
            </div>
        </div>
    </div>
</nav>
<br><br>
<div class="container mt-5">


  <h1>Contacto</h1>
  <p>¡Contáctanos para obtener más información!</p>
  <div id="map-container"></div>
  <br><br>
  <p>Dirección: Montes Urales 2236, Guadalajara, Jalisco, Código Postal 44320</p>
  <p>Teléfono: (33) 1339-0936</p>
  <p>Email: bldngsolutions.mail@gmail.com</p>
</div>

<!-- Footer -->
<footer>
    <div class="footer">
        <p>&copy; 2023 BLDNGSolutions. Todos los derechos reservados.</p>
    </div>
</footer>

<script>
  // Función para inicializar el mapa
  function initMap() {
    var coordinates = { lat: 20.7049452, lng: -103.3194802 }; // Coordenadas de Montes Urales 2236
    var mapOptions = {
      zoom: 17,
      center: coordinates
    };
    var map = new google.maps.Map(document.getElementById("map-container"), mapOptions);

    // Marcador en Montes Urales 2236
    var marker = new google.maps.Marker({
      position: coordinates,
      map: map,
      title: "Montes Urales 2236, Guadalajara, Jalisco, Código Postal 44320"
    });
  }
</script>
<style>
  /* Estilo para el contenedor del mapa */
  #map-container {
    height: 400px;
    border-radius: 15px;
    overflow: hidden;
  }

  body {
    background-image: url("{{ url_for('static', filename = 'images/backgrounds/background1.png') }}");
    background-size: cover;
    background-repeat: no-repeat;
  }

  footer {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 70px;
    background: linear-gradient(to right, #33353f, #444654);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    z-index: 99;
  }

  footer .footer {
    height: 100%;
    max-width: 1250px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: auto;
    padding: 0 50px;
  }
</style>

<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAJzmmel__k7beEoyd-LhonGRhMrR2mEJE&callback=initMap" async
  defer></script>
{% endblock %}