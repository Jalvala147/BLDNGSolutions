{% extends './base.html' %}

{% block title %}Inicio{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/startpage/startdesign.css') }}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0">
{% endblock %}

{% block body %}
<div id="particles-js"></div>

<nav>
  <div class="navbar">
    <div class="logo">
      <a href="{{ url_for('startpage') }}">
        <img src="{{ url_for('static', filename='images/logo.png') }}" alt="BLDNGSolutions" class="logo-image">
        BLDNGSolutions
      </a>
    </div>
    <div class="nav-links">
      <ul class="links">
        <li><a href="{{ url_for('aboutUs') }}">Nosotros</a></li>
        <li><a href="{{ url_for('contact') }}">Contacto</a></li>
        <li><a href="{{ url_for('productsList') }}">Productos</a></li>
        <li>
          <a href="#">Login</a>
          <ul class="htmlCss-sub-menu sub-menu">
            <li><a href="{{ url_for('login') }}">Soy Cliente</a></li>
            <li><a href="{{ url_for('loginemp') }}">Soy Empleado</a></li>
            <li><a href="{{ url_for('loginadm') }}">Administrador</a></li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>

<swiper-container class="mySwiper" effect="cards" grab-cursor="true" autoplay="true" data-autoplay="5000" loop>
  <swiper-slide>
    <h4>¡Bienvenido a BLDNGSolutions!</h4>
    <p>Plataforma de administración enfocada a PyMEs dedicadas a la venta y renta de maquinaria de construcción.</p>
  </swiper-slide>
  <swiper-slide>
    <span class="material-symbols-outlined icon">person</span>
    <p>Apartado para clientes con herramientas para pedidos y seguimiento.</p>
  </swiper-slide>
  <swiper-slide>
    <span class="material-symbols-outlined icon">storefront</span>
    <p>Apartado de Ventas para procesar pedidos y contactar clientes.</p>
  </swiper-slide>
  <swiper-slide>
    <span class="material-symbols-outlined icon">warehouse</span>
    <p>Apartado de Almacén para control de maquinaria.</p>
  </swiper-slide>
  <swiper-slide>
    <span class="material-symbols-outlined icon">engineering</span>
    <p>Apartado de Mantenimiento para programar y registrar servicios.</p>
  </swiper-slide>
  <swiper-slide>
    <span class="material-symbols-outlined icon">local_shipping</span>
    <p>Apartado de Envíos para entregar pedidos al cliente final.</p>
  </swiper-slide>
  <swiper-slide>
    <span class="material-symbols-outlined icon">admin_panel_settings</span>
    <p>Apartado de Administración para empleados y resultados financieros.</p>
  </swiper-slide>
</swiper-container>

<script src="{{ url_for('static', filename='js/startpage/startpage.js') }}"></script>
<script src="{{ url_for('static', filename='js/particlesjs/particles.min.js') }}"></script>
<script src="{{ url_for('static', filename='js/particlesjs/particlesjs-config.json') }}"></script>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-element-bundle.min.js"></script>
{% endblock %}
