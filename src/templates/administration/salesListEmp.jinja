{% extends './base.html' %}

{% block title%}Listado de clientes de ventas{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/administration/listEmp.css')}}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,300,0,0" />

{% endblock %}


{% block body %}
<a href="{{ url_for('admin.employeelist') }}" class="btn">Atras</a>
<h1>Informacion de los empleados del area de ventas</h1>

<a href="{{ url_for('admin.salesAddEmp') }}" class="btn">Agregar nuevo empleado</a>

<table class="table1">
    <tr>
        <th>ID</th>
        <th>Nombre de usuario</th>
        <th>Nombre completo</th>
        <th>Correo electrónico</th>
        <th>Editar</th>
        <th>Eliminar</th>
    </tr>
    {% for user in users %}
    <tr>
        <td>{{ user[0] }}</td>
        <td>{{ user[1] }}</td>
        <td>{{ user[2] }}</td>
        <td>{{ user[3] }}</td>
        <td>
            <a href="{{ url_for('admin.salesUpdateEmp', id=user[0]) }}" class="material-symbols-rounded"
                data-symbol="edit"></a>
        </td>
        <td>
            <a href="{{ url_for('admin.salesDeleteEmp', id=user[0]) }}"
                onclick="return confirm('¿Estás seguro de que deseas eliminar este registro?')"
                class="material-symbols-rounded" data-symbol="delete"></a>
        </td>
    </tr>
    {% endfor %}
</table>

{% endblock %}