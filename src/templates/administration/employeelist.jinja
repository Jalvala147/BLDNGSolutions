{% extends './base.html' %}

{% block title%}CRUD{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/employeelist.css')}}">
<link rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,300,0,0" />
<link rel="stylesheet" href="{{ url_for('static', filename='css/login.css')}}">

{% endblock %}


{% block body %}

<a href="{{ url_for('admin.adminHome') }}" class="btn" >Atras</a>

<h1 align="center">Informacion de los empleados</h1>

<div class="login-card-container" align="center">
  <div class="login-card">
    <div class="navigation" align="center">
      <ul>
        <li class="list active" align="center">
          <a href="{{ url_for('admin.salesListEmp')}}">
            <span class="material-symbols-rounded">
              point_of_sale
            </span>
            <span class="text">Empleados de ventas</span>
          </a>
        </li>
        <li class="list">
          <a href="{{ url_for('admin.storListEmp')}}">
            <span class="material-symbols-rounded">
              inventory_2
            </span>
            <span class="text">Empleados de almacén</span>
          </a>
        </li>
        <li class="list">
          <a href="{{ url_for('admin.maintListEmp')}}">
            <span class="material-symbols-rounded">
              construction
            </span>
            <span class="text">Empleados de mantenimiento</span>
          </a>
        </li>
        <li class="list">
          <a href="{{ url_for('admin.shipListEmp')}}">
            <span class="material-symbols-rounded">
              local_shipping
            </span>
            <span class="text">Empleados de envios</span>
          </a>
        </li>

        <div class="indicator"></div>
      </ul>
    </div>
  </div>
</div>
{% endblock %}