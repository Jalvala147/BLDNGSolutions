{% extends './base.html' %}

{% block title%}Areas{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/administration/employeelist.css')}}">
<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,300,0,0" />

{% endblock %}


{% block body %}

<a href="{{ url_for('admin.adminHome') }}" class="btn">Atras</a>
<h1 align="center">Información de los empleados</h1>

<div class="login-card-container" align="center">
    <div class="login-card">
        <div class="navigation" align="center">
            <ul class="options-list">
                <li class="list active" align="center">
                    <a href="{{ url_for('admin.salesListEmp')}}" class="menu-link">
                        <span class="material-symbols-rounded">point_of_sale</span>
                        <span class="text">Empleados de ventas</span>
                    </a>
                </li>
                <li class="list">
                    <a href="{{ url_for('admin.storListEmp')}}" class="menu-link">
                        <span class="material-symbols-rounded">inventory_2</span>
                        <span class="text">Empleados de almacén</span>
                    </a>
                </li>
                <li class="list">
                    <a href="{{ url_for('admin.maintListEmp')}}" class="menu-link">
                        <span class="material-symbols-rounded">construction</span>
                        <span class="text">Empleados de mantenimiento</span>
                    </a>
                </li>
                <li class="list">
                    <a href="{{ url_for('admin.shipListEmp')}}" class="menu-link">
                        <span class="material-symbols-rounded">local_shipping</span>
                        <span class="text">Empleados de envíos</span>
                    </a>
                </li>
            </ul>
            <div class="indicator"></div>
        </div>
    </div>
</div>

<script>
    // Get all menu list items
    const menuItems = document.querySelectorAll('.list');

    // Add click event listeners to menu items
    menuItems.forEach(item => {
        item.addEventListener('click', () => {
            // Remove "active" class from all menu items
            menuItems.forEach(i => i.classList.remove('active'));

            // Add "active" class to the clicked item
            item.classList.add('active');
        });
    });
</script>
{% endblock %}