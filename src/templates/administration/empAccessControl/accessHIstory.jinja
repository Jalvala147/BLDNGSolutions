{% extends './base.html' %}

{% block title %} Historial de accesos de {{ name }} {% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/administration/listEmp.css') }}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

<style>
    .table-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.25rem;
        max-width: 1200px;
        margin: 1rem auto 1.5rem;
        border: none;
        background: transparent;
        box-shadow: none;
        overflow: visible;
    }

    .table-container > div {
        min-width: 0;
    }

    .table-container h2 {
        margin: 0 0 0.5rem;
        font-size: var(--erp-font-size-lg);
    }

    select {
        padding: 0.6rem 0.875rem;
        border: 1px solid var(--erp-border);
        border-radius: var(--erp-radius);
        width: min(220px, 100%);
        margin: 0.35rem 0 1rem;
        background: var(--erp-surface);
        color: var(--erp-text);
    }

    label {
        font-weight: 600;
        color: var(--erp-text);
    }
</style>
{% endblock %}

{% block body %}
<a href="{{ url_for('admin.accesscontrol') }}" class="btn">Atrás</a>

<h1>Historial de accesos de {{ name }}, ID:{{ id }}</h1>
<h1>Empleado de {% if access_records[0][2] == 2 %}Ventas{% elif access_records[0][2] == 5 %}Mantenimiento{% elif access_records[0][2] == 6 %}Envíos{% elif access_records[0][2] == 3 %}Almacén{% else %}Otro{% endif %}</h1>

<a href="{{ url_for('admin.employeeResults', id=id, name=name) }}" class="btn">Resultados puntualidad</a>

<a href="{{ url_for('admin.employeeResultsExits', id=id, name=name) }}" class="btn">Resultados salidas</a>

<div>
    <label for="monthSelect">Seleccionar mes:</label>
    <select id="monthSelect">
        {% for month in months %}
            <option value="{{ month[0] }}">{{ month[0] }}</option>
        {% endfor %}
    </select>
</div>

<div>
    <label for="periodSelect">Seleccionar periodo:</label>
    <select id="periodSelect">
        <option value="mes">Mensual</option>
        <option value="quincena1">Primera quincena</option>
        <option value="quincena2">Segunda quincena</option>
    </select>
</div>

<div id="selectedMonthInfo" style="display: none;"></div>
<div class="table-container">
    <div>
        <h2>Ingresos:</h2>
        <table class="table1">
            <tr>
                <th>Fecha</th>
            </tr>
            {% for access in access_records %}
            {% if access[1] == 1 %}
            <tr class="access-row">
                <td>{{ access[0] }}</td>
            </tr>
            {% endif %}
            {% endfor %}
        </table>
    </div>

    <div>
        <h2>Egresos:</h2>
        <table class="table1">
            <tr>
                <th>Fecha</th>
            </tr>
            {% for access in access_records %}
            {% if access[1] == 0 %}
            <tr class="access-row">
                <td>{{ access[0] }}</td>
            </tr>
            {% endif %}
            {% endfor %}
        </table>
    </div>
</div>

<script>
    const monthSelect = document.getElementById('monthSelect');
    const periodSelect = document.getElementById('periodSelect');
    const selectedMonthInfo = document.getElementById('selectedMonthInfo');
    const rows = document.querySelectorAll('.access-row');

    monthSelect.addEventListener('change', updateTable);
    periodSelect.addEventListener('change', updateTable);

    function updateTable() {
        const selectedMonth = monthSelect.value;
        const selectedPeriod = periodSelect.value;

        // Iterar a través de filas y ocultar/mostrar filas según el mes y período seleccionados
        rows.forEach(row => {
            const date = row.querySelector('td').textContent;
            const [year, month, day] = date.split('-');
            const dayNumber = parseInt(day, 10);

            //Se menciona como quincena pero en realidad son 14 dias o dos semanas, para que se ajuste correctamente la informacion en la tabla
            if ((selectedPeriod === 'mes' && date.startsWith(selectedMonth)) ||
                (selectedPeriod === 'quincena1' && dayNumber <= 14 && date.startsWith(selectedMonth)) ||
                (selectedPeriod === 'quincena2' && dayNumber > 14 && date.startsWith(selectedMonth))) {
                row.style.display = 'table-row';
            } else {
                row.style.display = 'none';
            }
        });

        if (selectedPeriod === 'mes') {
            selectedMonthInfo.textContent = `Registros del mes de ${selectedMonth}`;
        } else if (selectedPeriod === 'quincena1') {
            selectedMonthInfo.textContent = `Registros de la primera quincena de ${selectedMonth}`;
        } else if (selectedPeriod === 'quincena2') {
            selectedMonthInfo.textContent = `Registros de la segunda quincena de ${selectedMonth}`;
        }

        if (selectedPeriod === 'mes') {
            selectedMonthInfo.style.display = 'none';
        } else {
            selectedMonthInfo.style.display = 'block';
        }
    }
</script>

{% endblock %}
