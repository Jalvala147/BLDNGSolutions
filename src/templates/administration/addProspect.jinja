{% extends './base.html' %}

{% block title %}Agregar prospecto{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/administration/addEmp.css') }}">
<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,300,0,0" />
{% endblock %}

{% block body %}

<div class="add-employee-card-container" align="center">
    <div class="add-employee-card">
        <a href="{{ url_for('admin.prospects') }}" class="btn">Atras</a>
        <h1>Agregar nuevo prospecto</h1>
        <form method="POST">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

            <div class="form-item">
                <label for="fullname">Nombre completo:</label>
                <input type="text" id="fullname" name="fullname" required>
            </div>

            <div class="form-item">
                <label for="company">Empresa:</label>
                <input type="text" id="company" name="company" >
            </div>

            <div class="form-item">
                <label for="number">Número de teléfono:</label>
                <input type="text" id="number" name="number" required>
            </div>

            <div class="form-item">
                <label for="email">Correo electrónico:</label>
                <input type="email" id="email" name="email" required>
            </div>

            <button type="submit">Agregar prospecto</button>
        </form>
    </div>
</div>
{% endblock %}