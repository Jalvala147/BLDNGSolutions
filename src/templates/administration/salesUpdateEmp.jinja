{% extends './base.html' %}

{% block title %}Editar empleado de ventas{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/administration/updateEmp.css')}}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,300,0,0" />
{% endblock %}

{% block body %}
<div class="update-employee-container" align="center">
    <div class="update-employee-card">
    <a href="{{ url_for('admin.salesListEmp') }}" class="btn">Atrás</a>
    <h1>Editar empleado de ventas</h1>
        <form method="POST">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

            <div class="form-item">
                <label for="username">Nombre de usuario:</label>
                <input type="text" id="username" name="username" value="{{ user[1] }}" required>
            </div>

            <div class="form-item">
                <label for="fullname">Nombre completo:</label>
                <input type="text" id="fullname" name="fullname" value="{{ user[3] }}" required>
            </div>

            <div class="form-item">
                <label for="email">Correo electrónico:</label>
                <input type="email" id="email" name="email" value="{{ user[4] }}" required>
            </div>

            <button type="submit">Actualizar empleado</button>
        </form>
    </div>
</div>
{% endblock %}