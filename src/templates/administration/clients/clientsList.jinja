{% extends './base.html' %}

{% block title%}Listado de clientes{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/sales/clientsList.css')}}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,300,0,0" />
<link rel="shortcut icon" href="{{ url_for('static', filename='images/logo.ico') }}">
{% endblock %}

{% block body %}
<a href="{{ url_for('admin.adminHome') }}" class="btn btn-primary">Atrás</a>

<h1>Información de los Clientes</h1>

<table class="table1">
    <tr>
        <th>Número de usuario</th>
        <th>Nombre de usuario</th>
        <th>Nombre completo</th>
        <th>Correo electrónico</th>
        <th>Editar</th>
        <th>Eliminar</th>
    </tr>
    {% for user in users %}
    <tr>
        <td>{{ user[0] }}</td>
        <td>{{ user[1] }}</td>
        <td>{{ user[2] }}</td>
        <td>{{ user[3] }}</td>
        <td><a href="{{ url_for('admin.editClient', id=user[0]) }}">
            <span class="material-symbols-rounded">
            edit
            </span></a>
        </td>
        <td>
            <form method="POST" action="{{ url_for('admin.deleteClient', id=user[0]) }}" style="display:inline;"
                onsubmit="return confirm('¿Estás seguro de que deseas eliminar este registro? Esta acción eliminará al cliente completamente del sistema asi como sus archivos')">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <button type="submit" style="background:none;border:none;cursor:pointer;padding:0;color:inherit;">
                    <span class="material-symbols-rounded">delete</span>
                </button>
            </form>
        </td>
    </tr>
    {% endfor %}
</table>
{% endblock %}