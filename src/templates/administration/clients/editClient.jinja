{% extends './base.html' %}

{% block title %}Actualizar Cliente{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/crud/edit.css')}}">
{% endblock %}

{% block body %}
<a href="{{ url_for('admin.clientsList') }}" class="btn btn-primary">Atrás</a>

<div class="container">
    <h1>Editar cliente</h1>

    <form method="post">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <label for="username">Nombre de usuario:</label>
        <input type="text" id="username" name="username" value="{{ user[1] }}" required>
        <label for="fullname">Nombre completo:</label>
        <input type="text" id="fullname" name="fullname" value="{{ user[2] }}" required>
        <label for="email">Correo Electrónico:</label>
        <input type="text" id="email" name="email" value="{{ user[3] }}" required>
        <button type="submit">Guardar cambios</button>
    </form>
</div>
{% endblock %}