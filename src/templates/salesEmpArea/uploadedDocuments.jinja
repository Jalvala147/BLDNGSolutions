{% extends './base.html' %}

{% block title%}Documentos{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/sales/uploadedDocuments.css')}}">
<link rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,300,0,0" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
{% endblock %}

{% block body %}

<a href="{{ url_for('salesemp.clientsList') }}" class="btn btn-primary">Atrás</a>
<div class="container">
  <h1>Documentos</h1>
  <h2>Nota: solo se pueden visualizar documentos pdf en el navegador, si el archivo tiene otra extensión como .docx
    favor de descargarlo</h2>
  <table class="table1">
    <thead>
      <tr>
        <th>No.</th>
        <th>Archivo</th>
        <th>Descargar</th>
        <th>Visualizar</th>
        <th>Validar</th>
        <th>No válido</th>
        <th>Estado</th>
        <th>Solicitud de cambio</th>
        <th>Aceptar solicitud</th>
      </tr>
    </thead>
    <tbody>
      {% for file in documents %}
      <tr>
        <td>{{ file[0] }}</td>
        <td>{{ file[1] }}</td>
        <td>
          <a href="{{ url_for('salesemp.download_file', filename=file[1]) }}" class="btn btn-primary"
            onclick="return confirmDownload();"><span class="material-symbols-rounded">
              download
            </span></a>
        </td>
        <td>
          {% if file[1].lower().endswith('.pdf') %}
          <a href="{{ url_for('salesemp.view_file', filename=file[1]) }}" class="btn btn-primary" target="_blank">
            <span class="material-symbols-rounded">
              visibility
            </span>
          </a>
          {% else %}

          <button class="btn btn-primary" disabled>
            <span class="material-symbols-rounded">
              visibility
            </span>
          </button>
          {% endif %}
        </td>

        <td>
          <a href="{{ url_for('salesemp.mark_as_completed', file_id=file[0], user_id=user_id) }}"
            class="btn btn-primary btn-valid"><span class="material-symbols-rounded">
              done
            </span></a>
        </td>
        <td>
          <a href="{{ url_for('salesemp.mark_as_incomplete', file_id=file[0], user_id=user_id) }}"
            class="btn btn-primary btn-valid"><span class="material-symbols-rounded">
              close
            </span></a>
        </td>
        <td class="{% if file[2] == 1 %}valido{% elif file[2] == 0 %}no-valido{% else %}desconocido{% endif %}">
          {% if file[2] == 1 %}
          Valido
          {% elif file[2] == 0 %}
          No valido
          {% else %}
          Valor desconocido
          {% endif %}
        </td>
        <td style="{% if file[3] == 1 %}background-color: #d4ff00;{% endif %}">
          {% if file[3] == 1 %}
          Se necesita un cambio
          {% elif file[3] is none %}
          Sin solicitud
          {% elif file[3] == 0 %}
          En espera de modificacion
          {% endif %}
        </td>
        <td>
          <a href="{{ url_for('salesemp.accept_change_request', file_id=file[0], user_id=user_id) }}"
            class="btn btn-primary btn-valid"><span class="material-symbols-rounded">
              task
            </span>
          </a>
        </td>

      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div id="validation-message"
    style="display: none; background-color: #4CAF50; color: white; padding: 10px; border-radius: 10px;">
    Todos los documentos han sido validados, favor de marcar el botón de documentos validados del listado de pedidos.
  </div>

</div>

<style>
  .valido {
    background-color: #4CAF50;
    color: white;
  }

  .no-valido {
    background-color: #ff3c00;
    color: white;
  }
</style>

<script>
  function confirmDownload() {
    return confirm("¿Quieres descargar este documento?");
  }

  document.addEventListener("DOMContentLoaded", function () {
  // Función para verificar si todas las filas tienen "Valido" en la columna "Estado"
  function checkValidationStatus() {
    var rows = document.querySelectorAll(".table1 tbody tr");
    var allValid = true;
    for (var i = 0; i < rows.length; i++) {
      var cell = rows[i].querySelector("td:nth-child(7)"); // Cambiamos "td:last-child" a "td:nth-child(7)"
      if (cell.innerText.trim() !== "Valido") {
        allValid = false;
        break;
      }
    }

    // Mostrar el mensaje si todas las filas son válidas
    var validationMessage = document.getElementById("validation-message");
    if (allValid) {
      validationMessage.style.display = "block";
    } else {
      validationMessage.style.display = "none";
    }
  }

  // Llama a la función al cargar la página y cada vez que se realice un cambio en las filas
  checkValidationStatus();
  var tableBody = document.querySelector(".table1 tbody");
  tableBody.addEventListener("change", checkValidationStatus);
});


</script>

{% endblock %}