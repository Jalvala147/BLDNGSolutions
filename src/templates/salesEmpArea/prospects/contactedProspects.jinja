{% extends './base.html' %}

{% block title %}Clientes contactados{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/crud/read.css')}}">
<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,400,0,0" />

{% endblock %}

{% block body %}
<a href="{{ url_for('salesemp.prospects') }}" class="btn">Atras</a>

<h1>Clientes contactados</h1>

<table class="table1">
    <tr>
        <th>Cliente</th>
        <th>Empresa</th>
        <th>Telefono</th>
        <th>Email</th>
    </tr>

    {% for prospect in prospects %}
    <tr>
        <td>{{ prospect[1] }}</td>
        <td>{{ prospect[2] }}</td>
        <td>{{ prospect[3] }}</td>
        <td>{{ prospect[4] }}</td>
    </tr>
    {% endfor %}
</table>

{% endblock %}