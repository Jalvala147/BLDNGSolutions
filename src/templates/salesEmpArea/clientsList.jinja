{% extends './base.html' %}

{% block title%}Listado de clientes de ventas{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/sales/clientsList.css')}}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,300,0,0" />
<link rel="shortcut icon" href="static/images/logo.ico">
{% endblock %}


{% block body %}

<a href="{{ url_for('sales_emp_area') }}" class="btn btn-primary">Atrás</a>

<h1>Informacion de los Clientes</h1>

<table class="table1">
    <tr>
        <th>Documentos</th>
        <th>Numero de usuario</th>
        <th>Nombre de usuario</th>
        <th>Nombre completo</th>
        <th>Correo electrónico</th>
        {# <th>Eliminar</th> #}
        <th>Avisar a almacén</th>
    </tr>
    {% for user in users %}
    <tr>
        <td><a href="{{ url_for('salesemp.uploaded_documents', user_id=user[0]) }}"><button>Ver documentos subidos</button></a></td>
        <td>{{ user[0] }}</td>
        <td>{{ user[1] }}</td>
        <td>{{ user[2] }}</td>
        <td>{{ user[3] }}</td>
        {# <td><a href="">
            <input type="hidden" name="_method" value="DELETE">
            <span class="material-symbols-rounded" data-symbol="delete"></span></a>
        </td> #}
        <td><button>Notificar</button></td>
    </tr>
    {% endfor %}
</table>

{% for client in clients %}
<tr>
    <td>{{ client.id }}</td>
    <td>{{ client.name }}</td>
    <td>{{ client.email }}</td>
    <td><a href="/documents/{{ client.id }}">Documentos</a></td>
</tr>
{% endfor %}

{% endblock %}