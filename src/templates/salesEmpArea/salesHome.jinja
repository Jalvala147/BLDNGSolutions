{% extends './base.html' %}

{% block title %}Ventas{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/sales/salesHome.css') }}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0">
{% endblock %}

{% block body %}
<div class="module-home">
  <div class="module-home-top">
    <a class="module-home-brand" href="{{ url_for('startpage') }}">
      <img src="{{ url_for('static', filename='images/logo.png') }}" alt="Logo">
      <span>BLDNGSolutions</span>
    </a>
    <div class="module-home-actions">
      <a class="btn btn-secondary" href="{{ url_for('salesemp.logout') }}">
        <span class="material-symbols-rounded">logout</span> Salir
      </a>
    </div>
  </div>

  <section class="module-home-hero">
    <p class="eyebrow">Área de ventas</p>
    <h1>Bienvenido, {{ current_user.fullname }}</h1>
    <p>Gestiona clientes, pedidos, rentas y prospección desde un solo lugar.</p>
  </section>

  <ul class="module-home-grid">
    <li>
      <a class="module-home-card" href="{{ url_for('salesemp.clientsList') }}">
        <div class="card-icon"><span class="material-symbols-rounded">account_circle</span></div>
        <h2 class="card-title">Clientes</h2>
        <p class="card-desc">Consulta y gestiona la cartera de clientes.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('salesemp.salesList') }}">
        <div class="card-icon"><span class="material-symbols-rounded">sell</span></div>
        <h2 class="card-title">Ventas</h2>
        <p class="card-desc">Pedidos de venta activos y seguimiento.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('salesemp.rentsList') }}">
        <div class="card-icon"><span class="material-symbols-rounded">list_alt</span></div>
        <h2 class="card-title">Rentas</h2>
        <p class="card-desc">Control de rentas y cancelaciones.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('salesemp.newRequest') }}">
        <div class="card-icon"><span class="material-symbols-rounded">notifications_active</span></div>
        <h2 class="card-title">Solicitudes nuevas</h2>
        <p class="card-desc">Revisa y clasifica pedidos entrantes.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('salesemp.prospects') }}">
        <div class="card-icon"><span class="material-symbols-rounded">group_add</span></div>
        <h2 class="card-title">Prospección</h2>
        <p class="card-desc">Captura y da seguimiento a prospectos.</p>
      </a>
    </li>
  </ul>
</div>
{% endblock %}
