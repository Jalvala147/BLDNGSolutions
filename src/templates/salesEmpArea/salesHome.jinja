{% extends './base.html' %}

{% block title%}Ventas{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/sales/salesHome.css')}}">
<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,400,0,0" />
{% endblock %}


{% block body %}
<div id="particles-js"></div>
<style>
    body {
        background-image: url("{{ url_for('static', filename = 'images/backgrounds/background1.png') }}");
        background-size: cover;
        background-repeat: no-repeat;
    }

    #particles-js {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;

    }
</style>

<div class="logout" style="position: absolute; top: 15px; right: 10px;">
    <a class="btn btn-secondary" href="{{ url_for('salesemp.logout') }}">
        <span class="material-symbols-rounded" style="vertical-align: middle;">logout</span>
        Cerrar Sesión
    </a>
</div>

<header class="header">
    <nav>
        <div class="logo">
            <a title="logo" href="/startpage"><img src="static/images/logo.png" class="logo" /></a>
        </div>

    </nav>
</header>



<div class="user">
    <h1>Bienvenido, {{current_user.fullname}}</h1>
    <h3>{{current_user.id}}</h3>

    <h1>Empleados de ventas</h1>
</div>

<div class="navigation" align="center">
    <ul>
        <li class="list active">
            <a href="/salesEmpArea/clientsList">

                <span class="icon">
                    <ion-icon name="home-outline"></ion-icon>
                </span>
                <span class="text">Clientes</span>
            </a>
        </li>
        <li class="list">
            <a href="/salesEmpArea/salesList">
                <span class="icon">
                    <ion-icon name="person-outline"></ion-icon>
                </span>
                <span class="text">Ventas</span>
            </a>
        </li>
        <li class="list">
            <a href="/salesEmpArea/rentsList">
                <span class="icon">
                    <ion-icon name="chatbox-outline"></ion-icon>
                </span>
                <span class="text">Rentas</span>
            </a>
        </li>
        <li class="list">
            <a href="/salesEmpArea/newRequest">
                <span class="icon">
                    <ion-icon name="settings-outline"></ion-icon>
                </span>
                <span class="text">Solicitudes</span>
            </a>
        </li>
        <li class="list">
            <a href="/salesEmpArea/prospects">
                <span class="icon">
                    <ion-icon name="information-circle-outline"></ion-icon>
                </span>
                <span class="text">Prospeccion</span>
            </a>
        </li>
        <div class="indicator"></div>
    </ul>
</div>

{# Script para manejar la selección del menu en la barra inferior #}
<script src="{{ url_for('static', filename='js/selectionItems.js') }}"></script>


<script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>

{# Importamos las particulas #}
<script src="{{ url_for('static', filename='js/particlesjs/particles.min.js') }}"></script>
<script src="{{ url_for('static', filename='js/particlesjs/particlesjs-config.json') }}"></script>
{% endblock %}