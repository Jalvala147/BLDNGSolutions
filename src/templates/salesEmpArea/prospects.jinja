{% extends './base.html' %}

{% block title %}Prospeccion{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/crud/read.css')}}">
<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,400,0,0" />

{% endblock %}


{% block body %}

<a href="{{ url_for('sales_emp_area') }}" class="btn">Atras</a>


<h1>Prospeccion de clientes</h1>
<a href="{{ url_for('salesemp.add_prospect') }}" class="btn">Agregar prospecto de cliente</a>

<table class="table1">
    <tr>
        <th>Cliente</th>
        <th>Telefono</th>
        <th>Email</th>
        <th>Estado</th>
        <th>Contactado</th>
        <th>Editar</th>
        <th>Eliminar</th>

    </tr>

    {% for prospect in prospects %}
    <tr>
        <td>{{ prospect[1] }}</td>
        <td>{{ prospect[2] }}</td>
        <td>{{ prospect[3] }}</td>
        <td>{{ prospect[4] }}</td>
        <td></td>
        <td>
            <a href="{{ url_for('salesemp.edit_prospect', prospect_id=prospect[0]) }}" class="btn"><span
                    class="material-symbols-rounded">
                    edit
                </span></a>
        </td>
        <td>
            <form method="post" action="{{ url_for('salesemp.delete_prospect', prospect_id=prospect[0]) }}">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <button type="submit" class="btn btn-primary" onclick="return confirmDelete();"><span
                        class="material-symbols-rounded">
                        delete
                    </span>
                </button>
            </form>
        </td>

    </tr>
    {% endfor %}
</table>

{% endblock %}