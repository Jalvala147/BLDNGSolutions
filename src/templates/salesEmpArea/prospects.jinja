{% extends './base.html' %}

{% block title %}Prospeccion de clientes{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/sales/clientsList.css')}}">
<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,400,0,0" />

{% endblock %}

{% block body %}
<a href="{{ url_for('sales_emp_area') }}" class="btn">Atras</a>

<h1>Prospeccion de clientes</h1>
<a href="{{ url_for('salesemp.add_prospect') }}" class="btn">Agregar prospecto de cliente</a>


<table class="table1">
    <tr>
        <th>Cliente</th>
        <th>Empresa</th>
        <th>Telefono</th>
        <th>Email</th>
        <th>Marcar como contactado</th>
        <th>Editar</th>
    </tr>

    {% for prospect in prospects %}
    <tr>
        <td>{{ prospect[1] }}</td>
        <td>{{ prospect[2] }}</td>
        <td>{{ prospect[3] }}</td>
        <td>{{ prospect[4] }}</td>
        <td>
            <a href="{{ url_for('salesemp.mark_contacted', prospect_id=prospect[0]) }}" class=""
                onclick="return confirm('¿Estás seguro de marcar como contactado?')"><button class="buttongreen">
                <span class="material-symbols-rounded">done</span></button>
            </a>
        </td>

        <td>
            <a href="{{ url_for('salesemp.edit_prospect', prospect_id=prospect[0]) }}" class=""><button class="button">
            <span class="material-symbols-rounded">edit</span></button>
            </a>
        </td>
    </tr>
    {% endfor %}
</table>
<a href="{{ url_for('salesemp.contactedProspects') }}" class="btn">
    <p>Clientes</p>
    <p>contactados</p>
</a>
{% endblock %}