{% extends './base.html' %}

{% block title %}Nuevas solicitudes{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/sales/clientsList.css')}}">
<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,400,0,0" />

{% endblock %}


{% block body %}

<a href="{{ url_for('sales_emp_area') }}" class="btn">Atras</a>
<link rel="shortcut icon" href="{{ url_for('static', filename='images/logo.ico') }}">


<h1>Página de Nuevas solicitudes</h1>
<h1>Solicitudes pendientes</h1>

<p>Los pedidos de tipo renta se muestran en un color amarillo</p>
<p>Los pedidos de tipo compra se muestran en un color naranja</p>
<br>

<div class="table-container">
    <table class="table1">
        <thead>
            <tr>
                <th>No. de Solicitud</th>
                <th>Solicitante</th>
                <th>Correo</th>
                <th>Máquinas</th>
            </tr>
        </thead>
        <tbody>
            {% for order in orders %}
            <tr>
                <td class="azul-claro">{{ order[0] }}</td>
                <td {% if order[1]==0 %}class="naranja" {% elif order[1]==1 %}class="amarillo" {% endif %}>{{ order[2]
                    }}</td>
                <td {% if order[1]==0 %}class="naranja" {% elif order[1]==1 %}class="amarillo" {% endif %}>{{ order[3]
                    }}</td>
                <td {% if order[1]==0 %}class="naranja" {% elif order[1]==1 %}class="amarillo" {% endif %}>{{ order[4] |
                    upper}}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<style>
    .table-container {
        max-height: 600px;
        overflow-y: auto;
    }

    .table-container .table1 thead th {
        position: sticky;
        top: 0;
        z-index: 2;
    }
</style>


{% endblock %}