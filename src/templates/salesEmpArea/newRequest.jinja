{% extends './base.html' %}

{% block title %}Nuevas solicitudes{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/crud/read.css')}}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,400,0,0" />

{% endblock %}


{% block body %}

<a href="{{ url_for('sales_emp_area') }}" class="btn" >Atras</a>
<link rel="shortcut icon" href="{{ url_for('static', filename='images/logo.ico') }}">


<h1>Pagina de Nuevas solicitudes</h1>
<h1>Solicitudes pendientes</h1>

<table class="table1">
    <tr>
        <th>No. de Solicitud</th>
        <th>Solicitante</th>
        <th>Correo</th>
        <th>Maquinas</th>
    </tr>

    {% for order in orders %}
    <tr>
        <td>{{ order[0] }}</td>
        <td>{{ order[1] }}</td>
        <td>{{ order[2] }}</td>
        <td>{{ order[3] | upper }}</td>
    </tr>
    {% endfor %}
</table>

{% endblock %}