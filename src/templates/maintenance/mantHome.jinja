{% extends './base.html' %}

{% block title %}Mantenimiento{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/maintenance/mantHome.css') }}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0">
{% endblock %}

{% block body %}
<div class="module-home">
  <div class="module-home-top">
    <a class="module-home-brand" href="{{ url_for('startpage') }}">
      <img src="{{ url_for('static', filename='images/logo.png') }}" alt="Logo">
      <span>BLDNGSolutions</span>
    </a>
    <div class="module-home-actions">
      <a class="btn btn-secondary" href="{{ url_for('logoutemp') }}">
        <span class="material-symbols-rounded">logout</span> Salir
      </a>
    </div>
  </div>

  <section class="module-home-hero">
    <p class="eyebrow">Área de mantenimiento</p>
    <h1>Bienvenido, {{ current_user.fullname }}</h1>
    <p>Programa servicios, atiende reportes y gestiona avisos de almacén.</p>
  </section>

  <ul class="module-home-grid">
    <li>
      <a class="module-home-card" href="{{ url_for('maintemp.mantMachines') }}">
        <div class="card-icon"><span class="material-symbols-rounded">precision_manufacturing</span></div>
        <h2 class="card-title">Máquinas</h2>
        <p class="card-desc">Equipos bajo tu responsabilidad.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('maintemp.mantMaintenance') }}">
        <div class="card-icon"><span class="material-symbols-rounded">construction</span></div>
        <h2 class="card-title">Mantenimiento</h2>
        <p class="card-desc">Preventivos y correctivos programados.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('maintemp.mantReports') }}">
        <div class="card-icon"><span class="material-symbols-rounded">report</span></div>
        <h2 class="card-title">Reportes</h2>
        <p class="card-desc">Fallas reportadas por clientes.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('maintemp.storageRequests') }}">
        <div class="card-icon"><span class="material-symbols-rounded">notifications</span></div>
        <h2 class="card-title">Avisos de almacén</h2>
        <p class="card-desc">Solicitudes de mantenimiento entrantes.</p>
      </a>
    </li>
  </ul>
</div>
{% endblock %}
