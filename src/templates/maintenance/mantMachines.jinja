{% extends './base.html' %}

{% block title %}Maquinas{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/storage/stoMachines.css')}}">
<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
{% endblock %}


{% block body %}
<a href="{{ url_for('maintenance_home') }}" class="btn btn-primary">Atrás</a>

<h1>Maquinas Mantenimiento</h1>

<table class="table1">
    <tr>
        <th>Id de la maquina</th>
        <th>Modelo</th>
        <th>Marca</th>
        <th>Tipo de maquina</th>
        <th>Historial</th>
    </tr>

    {% for machine in machines_data %}
    <tr>
        <td>{{ machine[0] }}</td>
        <td>{{ machine[1] }}</td>
        <td>{{ machine[2] }}</td>
        <td>{{ machine[3] }}</td>
        <td>
            <a href="{{ url_for('maintemp.mantHistory', machine_id=machine[0]) }}" class="btn btn-primary"><span
                    class="material-symbols-outlined">history</span></a>

        </td>
    </tr>
    {% endfor %}



</table>

{% endblock %}