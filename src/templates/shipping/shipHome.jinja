{% extends './base.html' %}

{% block title%}Mantenimiento{% endblock %}


{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/shipping/shipHome.css')}}">
<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,400,0,0" />
{% endblock %}


{% block body %}
<div id="particles-js"></div>
<style>
    body {
        background-image: url("{{ url_for('static', filename = 'images/backgrounds/background1.png') }}");
        background-size: cover;
        background-repeat: no-repeat;
    }

    #particles-js {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;

    }
</style>


<div class="logout" style="position: absolute; top: 15px; right: 10px;">
    <a class="btn btn-secondary" href="{{ url_for('salesemp.logout') }}">
        <span class="material-symbols-rounded" style="vertical-align: middle;">logout</span>
        Cerrar Sesión
    </a>
</div>

<header class="header">
    <nav>
        <div class="logo">
            <a title="logo" href="/startpage"><img src="{{ url_for('static', filename='images/logo.png') }}" class="logo" /></a>
        </div>

    </nav>
</header>

<div class="notifications" style="position: absolute; top: 60px; right: 10px;">
    <span class="material-symbols-rounded" style="font-size: 50px; color:white;" id="notification-icon">
        notifications
    </span>
    <span id="notification-count-badge" class="notification-badge">0</span>
    <div id="notification-popup" class="notification-popup">
        <!-- Aquí mostrarás el contenido de las notificaciones -->
    </div>
</div>

<div class="user">
    <h1>Bienvenido, {{current_user.fullname}}</h1>
    <h3>{{current_user.id}}</h3>

    <h1>Pagina de envios</h1>
</div>

<div class="navigation" align="center">
    <ul>
        <li class="list active" align="center">
            <a href="/shipping/orders">
                <span class="icon">
                    <span class="material-symbols-rounded">order_approve</span>
                </span>
                <span class="text">Pedidos</span>
            </a>
        </li>
        <li class="list">
            <a href="/shipping/newOrders">
                <span class="icon">
                    <span class="material-symbols-rounded">news</span>
                </span>
                <span class="text">Nuevos pedidos</span>
            </a>
        </li>
        <div class="indicator"></div>
    </ul>
</div>


{# Script para manejar la selección del menu en la barra inferior #}
<script src="{{ url_for('static', filename='js/selectionItems.js') }}"></script>

{# Importamos las particulas #}
<script src="{{ url_for('static', filename='js/particlesjs/particles.min.js') }}"></script>
<script src="{{ url_for('static', filename='js/particlesjs/particlesjs-config.json') }}"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const notificationIcon = document.getElementById('notification-icon');
        const notificationPopup = document.getElementById('notification-popup');
        const closeNotificationPopup = document.getElementById('close-notification-popup');

        let isPopupOpen = false;

        notificationIcon.addEventListener('click', function () {
            if (isPopupOpen) {
                notificationPopup.style.display = 'none';
            } else {
                // Hacer una solicitud AJAX al servidor para obtener las notificaciones en formato JSON
                const xhr = new XMLHttpRequest();
                xhr.open('GET', '/ship_notifications', true);

                xhr.onload = function () {
                    if (xhr.status === 200) {
                        const notifications = JSON.parse(xhr.responseText);
                        const notificationList = document.createElement('ul');
                        notificationList.classList.add('notification-list-container');

                        //notificationList.style.listStyleType = 'none';

                        // Crear elementos de lista para cada notificación
                        notifications.forEach(function (notification) {
                            const listItem = document.createElement('li');
                            listItem.textContent = `Pedido: ${notification[0]}, Número de máquina: ${notification[1]}, Dirección: ${notification[3]}`;
                            
                            listItem.classList.add('verde')

                            notificationList.appendChild(listItem);
                        });

                        notificationPopup.innerHTML = '';
                        notificationPopup.appendChild(notificationList);
                        notificationPopup.style.display = 'block';

                        // Actualizar el contador de notificaciones
                        const notificationCount = notifications.length;
                        const notificationCountBadge = document.getElementById('notification-count-badge');
                        notificationCountBadge.textContent = notificationCount;
                    }
                };

                xhr.send();
            }

            isPopupOpen = !isPopupOpen;
        });

        closeNotificationPopup.addEventListener('click', function () {
            notificationPopup.style.display = 'none';
            isPopupOpen = false;
        });
    });


    document.addEventListener('DOMContentLoaded', function () {
    // Hacer una solicitud AJAX para obtener las notificaciones
    const xhr = new XMLHttpRequest();
    xhr.open('GET', '/ship_notifications', true);

    xhr.onload = function () {
        if (xhr.status === 200) {
            const notifications = JSON.parse(xhr.responseText);
            const notificationCount = notifications.length;
            // Actualiza el contador de notificaciones
            document.getElementById('notification-count-badge').textContent = notificationCount;
        }
    };

    xhr.send();
});

</script>
{% endblock %}



