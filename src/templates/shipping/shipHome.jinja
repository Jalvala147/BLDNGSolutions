{% extends './base.html' %}

{% block title %}Envíos{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/shipping/shipHome.css') }}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0">
{% endblock %}

{% block body %}
<div class="module-home">
  <div class="module-home-top">
    <a class="module-home-brand" href="{{ url_for('startpage') }}">
      <img src="{{ url_for('static', filename='images/logo.png') }}" alt="Logo">
      <span>BLDNGSolutions</span>
    </a>
    <div class="module-home-actions">
      <div class="notifications">
        <span class="material-symbols-rounded" id="notification-icon">notifications</span>
        <span id="notification-count-badge" class="notification-badge">0</span>
        <div id="notification-popup" class="notification-popup"></div>
      </div>
      <a class="btn btn-secondary" href="{{ url_for('logoutemp') }}">
        <span class="material-symbols-rounded">logout</span> Salir
      </a>
    </div>
  </div>

  <section class="module-home-hero">
    <p class="eyebrow">Área de envíos</p>
    <h1>Bienvenido, {{ current_user.fullname }}</h1>
    <p>Coordina pedidos listos para entrega y rutas de envío.</p>
  </section>

  <ul class="module-home-grid">
    <li>
      <a class="module-home-card" href="{{ url_for('shipemp.orders') }}">
        <div class="card-icon"><span class="material-symbols-rounded">order_approve</span></div>
        <h2 class="card-title">Pedidos</h2>
        <p class="card-desc">Pedidos en proceso de envío.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('shipemp.newOrders') }}">
        <div class="card-icon"><span class="material-symbols-rounded">news</span></div>
        <h2 class="card-title">Nuevos pedidos</h2>
        <p class="card-desc">Solicitudes pendientes de despacho.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('shipemp.completedOrders') }}">
        <div class="card-icon"><span class="material-symbols-rounded">task_alt</span></div>
        <h2 class="card-title">Completados</h2>
        <p class="card-desc">Historial de envíos finalizados.</p>
      </a>
    </li>
  </ul>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const icon = document.getElementById('notification-icon');
  const popup = document.getElementById('notification-popup');
  const badge = document.getElementById('notification-count-badge');
  let open = false;

  function loadNotifications() {
    fetch('/ship_notifications')
      .then(r => r.json())
      .then(data => {
        const list = document.createElement('ul');
        list.className = 'notification-list-container';
        (data || []).forEach(item => {
          const li = document.createElement('li');
          li.className = 'verde';
          li.textContent = Array.isArray(item) ? `Pedido ${item[0]}` : String(item);
          list.appendChild(li);
        });
        popup.innerHTML = '';
        popup.appendChild(list);
        badge.textContent = (data || []).length;
      })
      .catch(() => { badge.textContent = '0'; });
  }

  loadNotifications();
  icon.addEventListener('click', function () {
    open = !open;
    popup.style.display = open ? 'block' : 'none';
    if (open) loadNotifications();
  });
});
</script>
{% endblock %}
