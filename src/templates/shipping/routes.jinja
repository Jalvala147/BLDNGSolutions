{% extends './base.html' %}

{% block title %}Rutas{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/shipping/shipping.css')}}">
{% endblock %}

{% block body %}
<a href="{{ url_for('shipemp.orders') }}" class="btn btn-primary">Atrás</a>
<h1>Google Maps Route</h1>
<div class="container">
<form id="locationForm">
    <label for="startLocation">Ubicación inicial:</label>
    <input type="text" id="startLocation" name="startLocation">
    <label for="endLocation">Ubicación final:</label>
    <input type="text" id="endLocation" name="endLocation" value="{{ end_location|default('') }}, jalisco"> //se indica la ubicacion final y que es en jalisco, para especificar
    <input type="submit" value="Buscar Ruta">
</form>
</div>

<p id="distanceMessage"></p>
<div id="map" style="height: 400px; width: 100%; border-radius: 10px;"></div>

<script>
    var map;
    var directionsService;
    var directionsRenderer;
    var currentRoute;

    function initMap() {
        // Obtener ubicación del usuario
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function (position) {
                var currentLat = position.coords.latitude;
                var currentLng = position.coords.longitude;

                // Crear el mapa centrado en la ubicación actual
                map = new google.maps.Map(document.getElementById('map'), {
                    center: { lat: currentLat, lng: currentLng },
                    zoom: 14
                });

                directionsService = new google.maps.DirectionsService();
                directionsRenderer = new google.maps.DirectionsRenderer();
                directionsRenderer.setMap(map);

                var locationForm = document.getElementById('locationForm');
                locationForm.addEventListener('submit', function (event) {
                    event.preventDefault();
                    calculateAndDisplayRoute();
                });
            }, function () {
                window.alert('No se pudo obtener la ubicación actual.');
            });
        } else {
            window.alert('Tu navegador no admite la geolocalización.');
        }
    }

    function calculateAndDisplayRoute() {
        var startLocation = document.getElementById('startLocation').value;
        var endLocation = document.getElementById('endLocation').value;

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function (position) {
                var currentLat = position.coords.latitude;
                var currentLng = position.coords.longitude;

                var request = {
                    origin: startLocation,
                    destination: endLocation,
                    travelMode: 'DRIVING'
                };

                directionsService.route(request, function (response, status) {
                    if (status === 'OK') {
                        directionsRenderer.setDirections(response);

                        // Calcular y mostrar la distancia
                        var route = response.routes[0];
                        var distance = 0;
                        for (var i = 0; i < route.legs.length; i++) {
                            distance += route.legs[i].distance.value;
                        }
                        var distanceKm = distance / 1000;
                        document.getElementById('distanceMessage').innerText = 'Distancia: ' + distanceKm.toFixed(2) + ' km';

                        // Guardar la ruta actual para usarla como base al generar una nueva ruta
                        currentRoute = response;
                    } else {
                        window.alert('Error al trazar la ruta: ' + status);
                    }
                });
            }, function () {
                window.alert('No se pudo obtener la ubicación actual.');
            });
        } else {
            window.alert('Tu navegador no admite la geolocalización.');
        }
    }

</script>

<script src="https://maps.googleapis.com/maps/api/js?key={{ api_key }}&callback=initMap" async defer></script>
{% endblock %}
