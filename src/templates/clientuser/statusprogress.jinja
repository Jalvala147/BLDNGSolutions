{% extends './base.html' %}

{% block title%}Progreso{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/clientuser/statusprogress.css')}}">
<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
{% endblock %}

{% block body %}
<a href="{{ url_for('clients.clientsHome') }}" class="btn btn-primary">Atrás</a>

<h1>Progreso de las ordenes</h1>

{% for order_data in orders_data %}
<div class="container">
    <h2>Orden #{{ order_data.id }}</h2>
    <div class="steps">
        <div>
            <span class="circle active">
                <span class="material-symbols-rounded">
                    call_received
                </span>
            </span>
            <div class="circle-text">
                Orden Recibida
            </div>
        </div>

        <div>
            <span class="circle{% if order_data.verifiedDocs == 1 %} active{% endif %}">
                <span class="material-symbols-rounded">
                    description
                </span>
            </span>
            <div class="circle-text">
                Documentos validados
            </div>
        </div>

        <div>
            <span class="circle{% if order_data.paymentMade == 1 %} active{% endif %}">
                <span class="material-symbols-rounded">
                    receipt_long
                </span>
            </span>
            <div class="circle-text">
                Pago verificado
            </div>
        </div>

        <div>
            <span class="circle{% if order_data.shipmentMade == 1 %} active{% endif %}">
                <span class="material-symbols-rounded">
                    local_shipping
                </span>
            </span>
            <div class="circle-text">
                Envio en progreso
            </div>
        </div>

        <div class="progress-bar">
            <span class="indicator"></span>
        </div>
    </div>
</div>
{% endfor %}

<script src="{{ url_for('static', filename='js/clientuser/statusprogress.js') }}"></script>

{% endblock %}