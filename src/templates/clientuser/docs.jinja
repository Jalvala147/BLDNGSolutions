{% extends './base.html' %}

{% block title %}Documentos{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/clientuser/docs.css') }}">
<link rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,300,0,0" />
{% endblock %}

{% block body %}

<a href="{{ url_for('clients.clientsHome') }}" class="btn btn-primary">Atrás</a>

<h1>Subir documento</h1>

<p>Favor de subir los siguientes documentos: </p>
<p>(De preferencia archivos PDF)</p>
<ul>
    <li>Comprobante de domicilio</li>
    <li>RFC</li>
    <li>Comprobante de pago indicando el número de pedido</li>
</ul>

{% with messages = get_flashed_messages() %}
{% if messages %}
<div id="flash-message" class="alert alert-success">
  {{ messages[0] }}
</div>
{% endif %}
{% endwith %}

<form method="POST" action="/docs" enctype="multipart/form-data" onsubmit="return confirmUpload();">
  <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

  <div class="drop-box" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)"
    ondrop="handleFileSelect(event)">
    <br>
    <div class="file-input-container">
      <input type="file" id="file-input" class="file-input" name="file" onchange="displaySelectedFile(event)">
      <label for="file-input" class="file-input-label">Seleccionar archivo</label>
      <span id="selected-file"></span>
    </div>
  </div>
  <button type="submit" class="custom-button custom-button-large">Cargar</button>
</form>

<div class="container">
  <h1>Documentos cargados</h1>
  <table class="table1">
    <thead>
      <tr>
        <th>Archivo</th>
        <th>Descargar</th>
        <th>Visualizar</th>
        <th>Estado</th>
        <th>Solicitar cambio de documento</th>
        <th>Eliminar (cambiar) Documento</th>
      </tr>
    </thead>
    <tbody>
      {% for file in documents %}
      <tr>
        <td>{{ file[1] }}</td>
        <td>
          <a href="{{ url_for('salesemp.download_file', filename=file[1]) }}" class="btn btn-primary"
            onclick="return confirmDownload();">
            <span class="material-symbols-rounded">
              download
            </span>
          </a>
        </td>
        <td>
          {% if file[1].lower().endswith('.pdf') %}
          <a href="{{ url_for('salesemp.view_file', filename=file[1]) }}" class="btn btn-primary" target="_blank">
            <span class="material-symbols-rounded">
              visibility
            </span>
          </a>
          {% else %}
          
          <button class="btn btn-primary" disabled>
            <span class="material-symbols-rounded">
              visibility
            </span>
          </button>
          {% endif %}
        </td>
        <td class="{% if file[2] == 1 %}valido{% elif file[2] == 0 %}no-valido{% else %}desconocido{% endif %}">
          {% if file[2] == 1 %}
          VALIDADO
          {% elif file[2] == 0 %}
          NO VALIDO
          {% else %}
          Valor desconocido
          {% endif %}
        </td>
        <td>
          <a href="{{ url_for('clients.request_change_document', document_id=file[0]) }}" class="btn btn-danger" onclick="return confirm('¿Quieres solicitar cambio de este documento?');">
              <span class="material-symbols-rounded">
                  article_shortcut
              </span>
          </a>
        </td>
        <td>
          <a href="{{ url_for('clients.delete_document', document_id=file[0]) }}" class="btn btn-danger{% if file[3] != 0 %} disabled-btn{% endif %}"
            {% if file[3] != 0 %}style="pointer-events: none; cursor: not-allowed;"{% endif %}
            onclick="return confirm('¿Quieres eliminar este documento?');">
            <span class="material-symbols-rounded">
              delete
            </span>
          </a>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
 

<style>
  .valido {
    background-color: #4CAF50;
    color: white;
  }
  
  .no-valido {
    background-color: #ff3c00;
    color: white;
  }

  .disabled-btn {
    background-color: #92c5fc;
    color: white;
  }
</style>

<script>
  function displaySelectedFile(event) {
    const fileInput = event.target;
    const selectedFile = document.getElementById('selected-file');

    if (fileInput.files.length > 0) {
      selectedFile.textContent = fileInput.files[0].name;
    } else {
      selectedFile.textContent = '';
    }
  }

  function confirmUpload() {
    return confirm("¿Quieres cargar este documento?");
  }

  // Ocultar el mensaje flash después de cierta duración
  const flashMessage = document.getElementById('flash-message');
  if (flashMessage) {
    const duration = 1500; // Duración del mensaje en milisegundos

    setTimeout(() => {
      flashMessage.style.display = 'none';
    }, duration);
  }

  const dropBox = document.querySelector('.drop-box');
  const fileInput = document.getElementById('file-input');

  dropBox.addEventListener('dragover', (event) => {
    event.preventDefault();
    dropBox.classList.add('dragover');
  });

  dropBox.addEventListener('dragleave', () => {
    dropBox.classList.remove('dragover');
  });

  dropBox.addEventListener('drop', (event) => {
    event.preventDefault();
    dropBox.classList.remove('dragover');
    fileInput.files = event.dataTransfer.files;
    displaySelectedFile(event);
  });

  function confirmDownload() {
    return confirm("¿Quieres descargar este documento?");
  }
</script>

{% endblock %}