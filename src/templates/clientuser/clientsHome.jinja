{% extends './base.html' %}

{% block title %}clients{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/clientuser/clients.css')}}">
<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,400,0,0" />
<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
{% endblock %}

{% block body %}
<div id="particles-js"></div>
<style>
    body {
        background-image: url("{{ url_for('static', filename = 'images/backgrounds/background1.png') }}");
        background-size: cover;
        background-repeat: no-repeat;
    }

    #particles-js {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;

    }
</style>


<div class="logout" style="position: absolute; top: 15px; right: 10px;">
    <a class="btn btn-secondary" href="{{ url_for('salesemp.logout') }}">
        <span class="material-symbols-rounded" style="vertical-align: middle;">logout</span>
        Cerrar Sesión
    </a>
</div>

<header class="header">
    <nav>
        <div class="logo">
            <a title="logo" href="/startpage"><img src="static/images/logo.png" class="logo" /></a>
        </div>

    </nav>
</header>

<div class="user">
    <h1>Bienvenido, {{current_user.fullname}}</h1>
    <h3>{{current_user.id}}</h3>
</div>

<div class="navigation" align="center">
    <ul>
        <li class="list active" align="center">
            <a href="/docs">
                <span class="icon">
                    <span class="form-item-icon material-symbols-rounded">Description</span>
                </span>
                <span class="text">Documentos</span>
            </a>
        </li>
        <li class="list">
            <a href="/orders">
                <span class="icon">
                    <span class="form-item-icon material-symbols-rounded">info</span>
                </span>
                <span class="text">Información de pedidos</span>
            </a>
        </li>
        <li class="list">
            <a href="/payments">
                <span class="icon">
                    <span class="form-item-icon material-symbols-rounded">Payments</span>
                </span>
                <span class="text">Pagos</span>
            </a>
        </li>
        <li class="list">
            <a href="/clientuser/statusprogress">
                <span class="icon">
                    <span class="form-item-icon material-symbols-rounded">pending</span>
                </span>
                <span class="text">Progreso</span>
            </a>
        </li>
        <li class="list">
            <a href="/clientuser/products">
                <span class="icon">
                    <span class="form-item-icon material-symbols-rounded">box</span>
                </span>
                <span class="text">Productos</span>
            </a>
        </li>
        <li class="list">
            <a href="/clientuser/makereport">
                <span class="icon">
                    <span class="material-symbols-rounded">
                        report
                    </span>
                </span>
                <span class="text">Reportar </span>
            </a>
        </li>
        <div class="indicator"></div>
    </ul>
</div>

{# Script para manejar la selección del menu en la barra inferior #}
<script src="{{ url_for('static', filename='js/selectionItems.js') }}"></script>

{# Importamos las particulas #}
<script src="{{ url_for('static', filename='js/particlesjs/particles.min.js') }}"></script>
<script src="{{ url_for('static', filename='js/particlesjs/particlesjs-config.json') }}"></script>

{% endblock %}