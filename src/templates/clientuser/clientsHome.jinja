{% extends './base.html' %}

{% block title %}Clientes{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/clientuser/clients.css') }}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0">
{% endblock %}

{% block body %}
<div class="module-home">
  <div class="module-home-top">
    <a class="module-home-brand" href="{{ url_for('startpage') }}">
      <img src="{{ url_for('static', filename='images/logo.png') }}" alt="Logo">
      <span>BLDNGSolutions</span>
    </a>
    <div class="module-home-actions">
      <div class="notifications">
        <span class="material-symbols-rounded" id="notification-icon">notifications</span>
        <span id="notification-count-badge" class="notification-badge">0</span>
        <div id="notification-popup" class="notification-popup"></div>
      </div>
      <a class="btn btn-secondary" href="{{ url_for('clients.logout') }}">
        <span class="material-symbols-rounded">logout</span> Salir
      </a>
    </div>
  </div>

  <section class="module-home-hero">
    <p class="eyebrow">Portal de clientes</p>
    <h1>Bienvenido, {{ current_user.fullname }}</h1>
    <p>Administra documentos, pedidos, pagos y reportes de maquinaria.</p>
  </section>

  <ul class="module-home-grid">
    <li>
      <a class="module-home-card" href="{{ url_for('clients.docs') }}">
        <div class="card-icon"><span class="material-symbols-rounded">description</span></div>
        <h2 class="card-title">Documentos</h2>
        <p class="card-desc">Sube y consulta tus documentos.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('clients.orders') }}">
        <div class="card-icon"><span class="material-symbols-rounded">info</span></div>
        <h2 class="card-title">Pedidos</h2>
        <p class="card-desc">Detalle e información de tus pedidos.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('clients.payments') }}">
        <div class="card-icon"><span class="material-symbols-rounded">payments</span></div>
        <h2 class="card-title">Pagos</h2>
        <p class="card-desc">Registra y revisa pagos pendientes.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('clients.statusprogress') }}">
        <div class="card-icon"><span class="material-symbols-rounded">pending</span></div>
        <h2 class="card-title">Progreso</h2>
        <p class="card-desc">Sigue el avance de tu solicitud.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('clients.products') }}">
        <div class="card-icon"><span class="material-symbols-rounded">inventory_2</span></div>
        <h2 class="card-title">Productos</h2>
        <p class="card-desc">Catálogo para renta o compra.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('clients.makereport') }}">
        <div class="card-icon"><span class="material-symbols-rounded">report</span></div>
        <h2 class="card-title">Reportar</h2>
        <p class="card-desc">Avisa fallas o incidencias.</p>
      </a>
    </li>
  </ul>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const icon = document.getElementById('notification-icon');
  const popup = document.getElementById('notification-popup');
  const badge = document.getElementById('notification-count-badge');
  let open = false;

  function loadNotifications() {
    fetch('/fetch_notifications')
      .then(r => r.json())
      .then(notifications => {
        const list = document.createElement('ul');
        list.className = 'notification-list-container';
        (notifications || []).forEach(n => {
          const li = document.createElement('li');
          li.textContent = `Archivo: ${n[1]}, Estado: ${n[2] === 1 ? 'Aceptado' : 'Rechazado'}`;
          li.className = n[2] === 1 ? 'verde' : 'rojo';
          list.appendChild(li);
        });
        popup.innerHTML = '';
        popup.appendChild(list);
        badge.textContent = (notifications || []).length;
      })
      .catch(() => { badge.textContent = '0'; });
  }

  loadNotifications();
  icon.addEventListener('click', function () {
    open = !open;
    popup.style.display = open ? 'block' : 'none';
    if (open) loadNotifications();
  });
});
</script>
{% endblock %}
