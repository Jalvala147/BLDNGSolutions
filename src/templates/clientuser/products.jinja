{% extends './base.html' %}

{% block title %}Productos{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename = 'css/clientuser/products.css') }}" />
<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

{% endblock %}


{% block body %}
<!-- Header -->
<header>
    <div class="nav container">
        <div>
            <a href="{{ url_for('clients.clientsHome') }}" class="btn">Atras</a>
            <a href="{{ url_for('clients.clientsHome') }}">
                <img src="{{ url_for('static', filename='images/logo.png') }}" class="small-logo" />
            </a>

        </div>
        <a class="logo2">BLDNGSolutions</a>

        <i class='bx bxs-shopping-bag' id="cart-icon"></i>

        <div class="cart">
            <h2 class="cart-title">Tus maquinas</h2>

            <div class="cart-content">

            </div>

            <div class="total">
                <div class="total-title">Total</div>
                <div class="total-price">$0</div>
            </div>

            <form action="{{ url_for('clients.place_order') }}" method="post">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="clientUser_id" value="{{ user_id }}">
                <input type="hidden" name="machine_price" value="{{ machine_price }}">
                <button type="submit" class="btn-buy">Pedir</button>
            </form>
            

            <i class='bx bx-x' id="close-cart"></i>
        </div>
    </div>
</header>

<div class="flash-message" id="flashMessage">
    Producto agregado al carrito
</div>

<section class="shop container">
    <h2 class="section-title">Productos</h2>
    <h2>Bienvenido, {{current_user.fullname}}</h2>

    <div class="shop-content">
        <!--Box 1-->
        <div class="product-box">
            <img src="{{ url_for('static', filename='images/products/fiat-hitachi-fd-175.png') }}" alt=""
                class="product-img">
            <h2 class="product-title">Fiat-Hitachi FD175</h2>
            <span class="price">$15000.40 MXN</span>
            <i class='bx bx-shopping-bag add-cart'></i>
        </div>
        <!--Box 2-->
        <div class="product-box">
            <img src="{{ url_for('static', filename='images/products/fiat-hitachi-fr-160-2.png') }}" alt=""
                class="product-img">
            <h2 class="product-title">Fiat-Hitachi FR160.2</h2>
            <span class="price">$16000.00 MXN</span>
            <i class='bx bx-shopping-bag add-cart'></i>
        </div>
        <!--Box 3-->
        <div class="product-box">
            <img src="{{ url_for('static', filename='images/products/volvo-ec-650.png') }}" alt="" class="product-img">
            <h2 class="product-title">Volvo EC650</h2>
            <span class="price">$16000.00 MXN</span>
            <i class='bx bx-shopping-bag add-cart'></i>
        </div>
        <!--Box 4-->
        <div class="product-box">
            <img src="{{ url_for('static', filename='images/products/cat4.jpg') }}" alt="" class="product-img">
            <h2 class="product-title">Volvo L330C</h2>
            <span class="price">$13000.00 MXN</span>
            <i class='bx bx-shopping-bag add-cart'></i>
        </div>
        <!--Box 5-->
        <div class="product-box">
            <img src="{{ url_for('static', filename='images/products/cat5.jpg') }}" alt="" class="product-img">
            <h2 class="product-title">Volvo L160</h2>
            <span class="price">$95000.00 MXN</span>
            <i class='bx bx-shopping-bag add-cart'></i>
        </div>
        <!--Box 6-->
        <div class="product-box">
            <img src="{{ url_for('static', filename='images/products/cat6.jpg') }}" alt="" class="product-img">
            <h2 class="product-title">Maquina 42324</h2>
            <span class="price">$75000.00 MXN</span>
            <i class='bx bx-shopping-bag add-cart'></i>
        </div>
        <!--Box 7-->
        <div class="product-box">
            <img src="{{ url_for('static', filename='images/products/cat7.png') }}" alt="" class="product-img">
            <h2 class="product-title">Maquina 42221</h2>
            <span class="price">$175000.00 MXN</span>
            <i class='bx bx-shopping-bag add-cart'></i>
        </div>
        <!--Box 8-->
        <div class="product-box">
            <img src="{{ url_for('static', filename='images/products/cat1.jpg') }}" alt="" class="product-img">
            <h2 class="product-title">Maquina 423422</h2>
            <span class="price">$55000.00 MXN</span>
            <i class='bx bx-shopping-bag add-cart'></i>
        </div>

    </div>
</section>



<script src="{{ url_for('static', filename='js/clientuser/products.js') }}"></script>


{% endblock %}