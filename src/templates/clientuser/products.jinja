{% extends './base.html' %}

{% block title %}Productos{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename = 'css/clientuser/products.css') }}" />
<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

{% endblock %}


{% block body %}

{% with messages = get_flashed_messages() %}
{% if messages %}
<div class="flash-messages">
    <ul>
        {% for message in messages %}
        <li>{{ message }}</li>
        {% endfor %}
    </ul>
</div>
{% endif %}
{% endwith %}

<!-- Header -->
<header>
    <div class="nav container">
        <div>
            <a href="{{ url_for('clients.clientsHome') }}" class="btn btn-secondary">Atrás</a>
            <a href="{{ url_for('clients.clientsHome') }}">
                <img src="{{ url_for('static', filename='images/logo.png') }}" class="small-logo" alt="Logo" />
            </a>
        </div>
        <a class="logo2" href="{{ url_for('clients.clientsHome') }}">BLDNGSolutions</a>
        <i class='bx bxs-shopping-bag' id="cart-icon" aria-label="Carrito"></i>
    </div>
</header>

<div class="cart">
    <h2 class="cart-title">Tus máquinas</h2>
    <div class="cart-content"></div>
    <div class="total">
        <div class="total-title">Total</div>
        <div class="total-price">$0</div>
    </div>
    <form id="purchase-form" action="{{ url_for('clients.place_order') }}" method="post"
        onsubmit="return confirm('¿Estás seguro de que quieres realizar este pedido?');">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="clientUser_id" value="{{ user_id }}">
        <input type="hidden" id="cart-machine-ids" name="cart_machine_ids" value="">
        <input type="hidden" name="cart_weeks" id="cart_weeks" value="">
        <input type="hidden" name="cart_total" id="cart_total" value="">
        <input type="hidden" name="cart-type" id="cart-type" value="">
        <button type="submit" class="btn-buy">Pedir</button>
    </form>
    <i class='bx bx-x' id="close-cart"></i>
</div>

<div class="flash-message" id="flashMessage">
    Producto agregado al carrito
</div>

<section class="shop container">
    <h2 class="section-title">Productos</h2>
    <h2>Bienvenid@, {{ current_user.fullname }}</h2>

    <div class="user-options">
        <select id="purchase-option" name="purchase-option">
            <option value="renta" selected>Renta</option>
            <option value="compra">Compra</option>
        </select>
    </div>

    <div class="shop-content">
        {% for product in products %}
        <div class="product-box" data-machine-id="{{ product.id }}">
            <img src="{{ url_for('static', filename='images/products/' + product.image) }}" alt="{{ product.name }}" class="product-img">
            <h4 class="machine-id" style="display: none;">{{ product.id_Machine }}</h4>
            <h2 class="product-title">{{ product.name }}</h2>
            <span class="price-label">Rentas desde</span>
            <span class="price" data-price-renta="{{ product.price }}">${{ product.price }} MXN</span>
            <span class="price-label">Precio de venta</span>
            <span class="sell_price" data-price-compra="{{ product.sell_price }}">${{ product.sell_price }} MXN</span>
            <i class='bx bx-shopping-bag add-cart' title="Agregar al carrito"></i>
        </div>
        {% else %}
        <p class="empty-catalog">No hay productos disponibles por ahora.</p>
        {% endfor %}
    </div>
</section>

<script src="{{ url_for('static', filename='js/clientuser/products.js') }}"></script>
{% endblock %}