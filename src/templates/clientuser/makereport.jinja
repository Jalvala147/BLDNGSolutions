{% extends './base.html' %}

{% block title %}Rentas{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/clientuser/payments.css')}}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
{% endblock %}

{% block body %}

{% with messages = get_flashed_messages() %}
    {% if messages %}
    <div id="flash-messages">
        <ul>
            {% for message in messages %}
            <li>{{ message }}</li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}
{% endwith %}

<a href="{{ url_for('clients.clientsHome') }}" class="btn">Atrás</a>

<style>
#flash-messages {
    margin-top: 10px;
    padding: 10px;
    border-radius: 10px;
    background-color: #4CAF50;
    color: #fff;
}

#flash-messages ul {
    list-style: none;
    padding-left: 0;
}

#flash-messages li {
    margin-bottom: 5px;
}
</style>


<h1>Generar un reporte sobre las máquinas</h1>
<h1>Usuario: {{current_user.fullname}} {{current_user.id}}</h1>

<form method="POST" onsubmit="return validateForm();">
    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
    <div class="form-group">
        <label for="machine_id">Selecciona una máquina:</label>
        <select id="machine_id" name="machine_id" class="form-control" autocomplete="off">
            <option value="" disabled selected>Selecciona una maquina</option>
            {% for order_id, machine_desc in machine_info.items() %}
            <option value="{{ order_id }}">{{ machine_desc }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="form-group">
        <label for="description">Descripción de la falla:</label>
        <textarea name="description" class="form-control" rows="4"></textarea>
    </div>
    <button type="submit" id="submitBtn" class="btn btn-primary" disabled>Enviar Reporte</button>
</form>

<script>
    function validateForm() {
        var selectedMachine = document.getElementById("machine_id").value;
        if (selectedMachine === "") {
            alert("Por favor, selecciona una máquina antes de enviar el reporte.");
            return false; // Evita el envío del formulario
        }
        return true; // Permite el envío del formulario si se ha seleccionado una máquina
    }

    // Habilita o deshabilita el botón "Enviar Reporte" según la selección
    document.getElementById("machine_id").addEventListener("change", function() {
        var selectedMachine = document.getElementById("machine_id").value;
        var submitBtn = document.getElementById("submitBtn");
        if (selectedMachine === "") {
            submitBtn.disabled = true;
        } else {
            submitBtn.disabled = false;
        }
    });

    // Oculta el mensaje flash después de 1.5 segundos
    var flashMessages = document.getElementById("flash-messages");
    if (flashMessages) {
        setTimeout(function() {
            flashMessages.style.display = "none";
        }, 1500);
    }
</script>

{% endblock %}
