{% extends './base.html' %}

{% block title %}Login administrador{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/login.css') }}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
{% endblock %}

{% block body %}
<a href="{{ url_for('startpage') }}" class="inicio">
  <img src="{{ url_for('static', filename='images/logo.png') }}" alt="">
  Inicio
</a>

<div class="login-card-container">
  <div class="login-card">
    {% with messages = get_flashed_messages() %}
      {% if messages %}
        {% for message in messages %}
        <div class="alert alert-primary alert-dismissible fade show" role="alert">
          {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        {% endfor %}
      {% endif %}
    {% endwith %}

    <div class="login-card-logo">
      <a href="{{ url_for('startpage') }}">
        <img src="{{ url_for('static', filename='images/logo.png') }}" alt="BLDNG Solutions">
      </a>
    </div>

    <div class="login-card-header">
      <h1>Administrador</h1>
      <div>Inicia sesión para continuar</div>
    </div>

    <form class="login-card-form" action="{{ url_for('loginadm') }}" method="POST">
      <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
      <div class="form-item">
        <span class="form-item-icon material-symbols-rounded">person</span>
        <input type="text" placeholder="Usuario" name="username" required autocomplete="username">
      </div>
      <div class="form-item">
        <span class="form-item-icon material-symbols-rounded">lock</span>
        <input type="password" placeholder="Contraseña" name="password" required autocomplete="current-password">
      </div>
      <button type="submit">Entrar</button>
    </form>
  </div>
</div>
{% endblock %}
