{% extends './base.html' %}

{% block title %}Almacén{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/storage/storageHome.css') }}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0">
{% endblock %}

{% block body %}
<div class="module-home">
  <div class="module-home-top">
    <a class="module-home-brand" href="{{ url_for('startpage') }}">
      <img src="{{ url_for('static', filename='images/logo.png') }}" alt="Logo">
      <span>BLDNGSolutions</span>
    </a>
    <div class="module-home-actions">
      <div class="notifications">
        <span class="material-symbols-rounded" id="notification-icon">notifications</span>
        <span id="notification-count-badge" class="notification-badge">0</span>
        <div id="notification-popup" class="notification-popup"></div>
      </div>
      <a class="btn btn-secondary" href="{{ url_for('storageemp.logout') }}">
        <span class="material-symbols-rounded">logout</span> Salir
      </a>
    </div>
  </div>

  <section class="module-home-hero">
    <p class="eyebrow">Área de almacén</p>
    <h1>Bienvenido, {{ current_user.fullname }}</h1>
    <p>Inventario, historial de movimientos y avisos de mantenimiento.</p>
  </section>

  <ul class="module-home-grid">
    <li>
      <a class="module-home-card" href="{{ url_for('storageemp.stoMachines') }}">
        <div class="card-icon"><span class="material-symbols-rounded">precision_manufacturing</span></div>
        <h2 class="card-title">Máquinas</h2>
        <p class="card-desc">Catálogo e inventario de maquinaria.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('storageemp.stoHistory') }}">
        <div class="card-icon"><span class="material-symbols-rounded">history</span></div>
        <h2 class="card-title">Historial</h2>
        <p class="card-desc">Entradas y salidas registradas en almacén.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('storageemp.stoMaintenance') }}">
        <div class="card-icon"><span class="material-symbols-rounded">construction</span></div>
        <h2 class="card-title">Mantenimiento</h2>
        <p class="card-desc">Avisos y estado de equipos a revisar.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('storageemp.readyMachines') }}">
        <div class="card-icon"><span class="material-symbols-rounded">priority_high</span></div>
        <h2 class="card-title">En espera de salida</h2>
        <p class="card-desc">Pedidos listos para liberar maquinaria.</p>
      </a>
    </li>
    <li>
      <a class="module-home-card" href="{{ url_for('storageemp.readyMaintMachines') }}">
        <div class="card-icon"><span class="material-symbols-rounded">arrow_right_alt</span></div>
        <h2 class="card-title">Retiro por mantenimiento</h2>
        <p class="card-desc">Equipos marcados para retiro técnico.</p>
      </a>
    </li>
  </ul>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const icon = document.getElementById('notification-icon');
  const popup = document.getElementById('notification-popup');
  const badge = document.getElementById('notification-count-badge');
  let open = false;

  function loadNotifications() {
    fetch('/fetch_machines_notifications')
      .then(r => r.json())
      .then(data => {
        const list = document.createElement('ul');
        list.className = 'notification-list-container';
        (data || []).forEach(item => {
          const li = document.createElement('li');
          li.className = 'azul';
          li.textContent = Array.isArray(item) ? `Máquina ${item[0]}: ${item[1]} ${item[2]}` : String(item);
          list.appendChild(li);
        });
        popup.innerHTML = '';
        popup.appendChild(list);
        badge.textContent = (data || []).length;
      })
      .catch(() => { badge.textContent = '0'; });
  }

  loadNotifications();
  icon.addEventListener('click', function () {
    open = !open;
    popup.style.display = open ? 'block' : 'none';
    if (open) loadNotifications();
  });
});
</script>
{% endblock %}
