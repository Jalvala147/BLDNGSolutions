{% extends './base.html' %}

{% block title%}Almacén{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/storage/storageHome.css')}}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
{% endblock %}


{% block body %}
<div id="particles-js"></div>
<style>
    body {
        background-image: url("{{ url_for('static', filename = 'images/backgrounds/background1.png') }}");
        background-size: cover;
        background-repeat: no-repeat;
    }

    #particles-js {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;

    }
</style>

<div class="logout" style="position: absolute; top: 15px; right: 10px;">
    <a class="btn btn-secondary" href="{{ url_for('salesemp.logout') }}">
        <span class="material-symbols-rounded" style="vertical-align: middle;">logout</span>
        Cerrar Sesión
    </a>
</div>

<header class="header">
    <nav>
        <div class="logo">
            <a title="logo" href="/startpage"><img src="static/images/logo.png" class="logo" /></a>
        </div>

    </nav>
</header>

<div class="user">
    <h1>Bienvenido, {{current_user.fullname}}</h1>
    <h3>{{current_user.id}}</h3>
    
    <h1>Pagina de Almacén</h1>
</div>

<div class="navigation" align="center">
    <ul>
        <li class="list active" align="center">
            <a href="/storage/stoMachines">
                <span class="icon">
                    <span class="material-symbols-rounded">precision_manufacturing</span>
                </span>
                <span class="text">Maquinas</span>
            </a>
        </li>

        <li class="list">
            <a href="/storage/stoHistory">
                <span class="icon">
                    <span class="material-symbols-rounded">history</span>
                </span>
                <span class="text">Historial</span>
            </a>
        </li>

        <li class="list">
            <a href="/storage/stoMaintenance">
                <span class="icon">
                    <span class="material-symbols-rounded">construction</span>
                </span>
                <span class="text">Mantenimiento</span>
            </a>
        </li>
        <div class="indicator"></div>
    </ul>
</div>

{# Script para manejar la selección del menu en la barra inferior #}
<script src="{{ url_for('static', filename='js/selectionItems.js') }}"></script>

{# Importamos las particulas #}
<script src="{{ url_for('static', filename='js/particlesjs/particles.min.js') }}"></script>
<script src="{{ url_for('static', filename='js/particlesjs/particlesjs-config.json') }}"></script>

{% endblock %}