{% extends './base.html' %}

{% block title %}Historial{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/storage/storage.css')}}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,400,0,0" />
{% endblock %}

{% block body %}
<a href="{{ url_for('storageemp.stoHistory') }}" class="btn btn-primary">Atras</a>

<h1><p> Historial máquina #{{machine_id}} </p> <p>{{ brand | upper }} {{ model | upper }}</p></h1>

<h3>Número de entrdas al almacén: {{ entry_dates|length }}</h3>
<h3>Némero de salidas del almacen: {{ exit_dates|length }}</h3>

<div class="table-container">
    <table class="table1">
        <thead>
            <tr>
                <th>Fechas de ingreso al almacén</th>
                <th>Fechas de salida del almacén</th>
            </tr>
        </thead>
        <tbody>
            {% for entry_date in entry_dates %}
            <tr>
                <td>{{ entry_date }}</td>
                <td></td>  
            </tr>
            {% endfor %}

            {% for exit_date in exit_dates %}
            <tr>
                <td></td>  
                <td>{{ exit_date }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>


{% endblock %}