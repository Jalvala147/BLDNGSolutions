{% extends './base.html' %}

{% block title %}Agregar Maquina{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/storage/addMachine.css')}}">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,400,0,0" />
{% endblock %}

{% block body %}

<a href="{{ url_for('storageemp.stoMachines') }}" class="btn btn-primary">Atras</a>

<div class="container">

    <h1>Agregar Nueva Maquina</h1>

    <form method="post" action="{{ url_for('storageemp.add_machine') }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <label for="model">Modelo:</label>
        <input type="text" name="model" required>
        <br>
        <label for="brand">Marca:</label>
        <input type="text" name="brand" required>
        <br>
        <label for="type">Tipo de maquina:</label>
        <input type="text" name="type" required>
        <br>
        <label for="status">Estado:</label>
        <input type="text" name="status" required>
        <br>
        <label for="currentUser">Cliente actual:</label>
        <input type="text" name="currentUser" required>
        <br>
        <button type="submit" class="btn btn-primary">Guardar</button>
    </form>

</div>

{% endblock %}
