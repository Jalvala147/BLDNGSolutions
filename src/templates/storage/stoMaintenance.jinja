{% extends './base.html' %}

{% block title %}Mantenimiento{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/storage/stoMaint.css')}}">

<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@48,400,0,0" />
{% endblock %}


{% block body %}

<a href="{{ url_for('storage_home') }}" class="btn btn-primary">Atras</a>

<h1>Aviso de mantenimiento a maquina</h1>

<table class="table1">
    <tr>
        <td>Id de la Maquina</td>
        <td>Modelo de la Maquina</td>
        <td>Mantenimiento</td>
    </tr>

    {% for machine in machines_data %}
    <tr>
        <td>{{ machine[0] }}</td>
        <td>{{ machine[1] }}</td>
        <td>
            <form method="POST" action="/storage/preventive/{{ machine[0] }}"
                onsubmit="return confirmAction('preventive');">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <button type="submit" class="btn btn-primary">preventive</button>
            </form>
            <form method="POST" action="/storage/corrective/{{ machine[0] }}"
                onsubmit="return confirmAction('corrective');">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <button type="submit" class="btn btn-primary">corrective</button>
            </form>
        </td>
    </tr>
    <script>
        function confirmAction(action) {
            return confirm(`¿Estás seguro que quieres marcar esta máquina para dar mantenimiento ${action}?`);
        }
    </script>

    {% endfor %}
</table>


{% endblock %}