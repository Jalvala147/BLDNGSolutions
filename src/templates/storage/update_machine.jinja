{% extends './base.html' %}

{% block title %}Actualizar Máquina{% endblock %}

{% block customCSS %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/crud/edit.css')}}">
{% endblock %}

{% block body %}
<a href="{{ url_for('storageemp.stoMachines') }}" class="btn btn-primary">Atras</a>

<div class="container">

    <h1>Actualizar Máquina</h1>

    <form method="post" action="{{ url_for('storageemp.update_machine', machine_id=machine_data[0]) }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <label for="model">Modelo:</label>
        <input type="text" id="model" name="model" value="{{ machine_data[1] }}" required>
        <label for="brand">Marca:</label>
        <input type="text" id="brand" name="brand" value="{{ machine_data[2] }}" required>
        <label for="type">Tipo de máquina:</label>
        <input type="text" id="type" name="type" value="{{ machine_data[3] }}" required>
        <button type="submit">Guardar cambios</button>
    </form>

</div>
{% endblock %}

